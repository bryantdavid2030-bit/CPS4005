# Copy to .env and fill in.
#
# Any variable prefixed with EXPO_PUBLIC_ is embedded in the JS bundle
# and available at runtime via process.env. Everything else is only
# used by build tooling and CI.

# Runtime
EXPO_PUBLIC_API_BASE=https://api.humnsprt.com/v1

# Enquiry endpoint — the public URL of the Cloudflare Worker in worker/.
# A working default is already baked into src/services/api.ts so the
# app works out of the box. Only set this if you want to point at a
# different Worker (e.g. a staging environment).
# Default: https://humnsprt-enquiries.shy-sun-d665.workers.dev/enquiries
EXPO_PUBLIC_ENQUIRY_ENDPOINT=

# Sentry
SENTRY_DSN=
SENTRY_ORG=humnsprt
SENTRY_PROJECT=humnsprt-mobile
SENTRY_AUTH_TOKEN=

# Expo / EAS
EXPO_TOKEN=

# Apple
APPLE_ID=
APPLE_TEAM_ID=
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_BASE64=

# Google Play
PLAY_JSON_KEY_BASE64=
